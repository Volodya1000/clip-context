{
  "name": "main-required-checks",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Rust (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "Rust (windows-latest)",
            "integration_id": 15368
          },
          {
            "context": "Minimum Rust version 1.85",
            "integration_id": 15368
          },
          {
            "context": "Test coverage (90% minimum)",
            "integration_id": 15368
          },
          {
            "context": "Dependency security and licensing",
            "integration_id": 15368
          },
          {
            "context": "Repository hygiene",
            "integration_id": 15368
          },
          {
            "context": "TOML syntax and formatting",
            "integration_id": 15368
          },
          {
            "context": "Conventional Commits (Cocogitto)",
            "integration_id": 15368
          },
          {
            "context": "CHANGELOG.md is updated",
            "integration_id": 15368
          },
          {
            "context": "GitHub Actions security",
            "integration_id": 15368
          },
          {
            "context": "Search committed secrets",
            "integration_id": 15368
          },
          {
            "context": "Package Linux x86_64 (archive + deb)",
            "integration_id": 15368
          },
          {
            "context": "Package Windows x86_64 (zip + PATH installer)",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
